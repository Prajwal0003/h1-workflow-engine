                  "snippet": {
                    "text": "        run: |\n          if [ -n \"${{ github.event.inputs.target }}\" ]; then\n            python autopilot.py ${{ github.event.inputs.target }} --dynamic\n          else\n            python autopilot.py --dynamic\n          fi"
